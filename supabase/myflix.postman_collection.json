          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of [200]', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "pm.test('exactly one row', function () { pm.expect(pm.response.json().length).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
