{
  "info": {
    "name": "MyFlix API (CRUD)",
    "description": "All 7 MyFlix tables: POST, GET all, GET with a filter, PATCH, DELETE. Set the collection variable publishable_key (your sb_publishable_... key), then Run the collection in order. Temporary dev policies must be in place (anon open access). Cleans up after itself.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 genres",
      "description": "Pick-list of genres. POST creates a throwaway genre, then PATCH and DELETE clean it up.",
      "item": [
        {
          "name": "GET all genres",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{publishable_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/rest/v1/genres?select=id,name&order=name"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of [200]', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "pm.collectionVariables.set('action_id', pm.response.json().find(g => g.name === 'Action').id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET genres with a filter (name = Action)",
          "request": {
            "method": "GET",
            "header": [
